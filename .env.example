# Quickserves CRM Environment Configuration Template
# Copy this file to .env.local and fill in the values for your environment

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/quickserves_crm?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=replace_with_a_secure_random_secret_in_production

# Application URLs & Port
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
